{{ define "domain.go" -}}
package domain

{{ if .HasTime -}}
import (
	"errors"
	"time"
)
{{- else -}}
import "errors"
{{- end }}

type {{ .Entity.Pascal }} struct {
{{- range .DomainFields }}
	{{ .Pascal }} {{ .DomainType }}
{{- end }}
}

// Err{{ .Entity.Pascal }}NotFound lives in the domain, not in the service, so the HTTP layer
// can tell "no such record" from "something broke" and answer 404 rather than
// 500 — a handler never imports the service package.
var Err{{ .Entity.Pascal }}NotFound = errors.New("{{ .Entity.Words }} not found")
{{ end }}
