	session := helper.MustGetSession(ginCtx)
	helper.LogError(ginCtx, logMsg, cause)
{{- range .RefFields }}
	{{ .RefEntity.CamelPlural }}, err := ctrl.{{ .RefEntity.Camel }}Service.List{{ .RefEntity.Pascal }}Lookups(ginCtx.Request.Context())
	if err != nil {
