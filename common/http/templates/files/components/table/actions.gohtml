{{/*
  table/actions — the edit and delete buttons of a row, from a dto.TableRow.

  Edit loads the form into #modal. Delete posts the CSRF token and swaps the row
  out with hx-swap="outerHTML", so the handler answers an empty body.
*/}}
{{ define "table/actions" }}
  <div class="flex items-center justify-end gap-1">
    {{- if .EditURL }}
      <button type="button" class="btn btn-ghost btn-icon btn-sm"
              title="{{ localize .Language "actions.edit" }}"
              aria-label="{{ localize .Language "actions.edit" }}"
              hx-get="{{ .EditURL }}"
              hx-target="#modal"
              hx-swap="innerHTML">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </button>
    {{- end }}
    {{- if .DeleteURL }}
      <button type="button" class="btn btn-ghost btn-icon btn-sm text-danger"
              title="{{ localize .Language "actions.delete" }}"
              aria-label="{{ localize .Language "actions.delete" }}"
              hx-post="{{ .DeleteURL }}"
              hx-vals='{"csrf_token":"{{ .CSRFToken }}"}'
              hx-target="#{{ .ID }}"
              hx-swap="outerHTML swap:200ms"
              hx-confirm="{{ if .ConfirmDelete }}{{ .ConfirmDelete }}{{ else }}{{ localize .Language "table.confirm_delete" }}{{ end }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M9 6V4h6v2"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M5 6l1 14h12l1-14"/></svg>
      </button>
    {{- end }}
  </div>
{{ end }}
