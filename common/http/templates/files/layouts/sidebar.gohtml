{{ define "sidebar" }}
  <aside class="sidebar" id="sidebar">

    <div class="sidebar-head">
      <a href="/" class="flex items-center gap-2 shrink-0 px-1" title="{{ localize .Language "app.name" }}">
        <span class="w-6 h-6 rounded-md bg-brand text-white grid place-items-center text-[11px] font-bold">S</span>
        <span class="font-semibold text-[14px] collapse-when-collapsed">{{ localize .Language "app.name" }}</span>
      </a>
      <button class="btn btn-ghost btn-icon btn-sm hidden lg:flex ml-auto" data-action="sidebar-toggle" aria-label="{{ localize .Language "sidebar.toggle_menu" }}" title="{{ localize .Language "sidebar.toggle_menu" }}">
        <svg class="sidebar-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="btn btn-ghost btn-icon btn-sm lg:hidden ml-auto" data-action="sidebar-close" aria-label="{{ localize .Language "sidebar.close_menu" }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="sidebar-search">
      <div class="input-group">
        <span class="input-icon">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
        </span>
        <input type="text" class="input" placeholder="{{ localize .Language "topbar.search_text" }}" style="font-size:12.5px; padding:6px 28px 6px 30px;">
      </div>
    </div>

    <nav class="sidebar-nav">

      <a href="/" class="sidebar-link" title="{{ localize .Language "sidebar.home" }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        <span class="sidebar-label">{{ localize .Language "sidebar.home" }}</span>
      </a>

      {{/* scaffold:sidebar:items */}}

      <span class="sidebar-section">{{ localize .Language "sidebar.security.title" }}</span>

      <a href="/auth/user" class="sidebar-link" title="{{ localize .Language "sidebar.security.items.users" }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-3-3.87"/><path d="M4 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M16 11a4 4 0 0 0 0-8"/></svg>
        <span class="sidebar-label">{{ localize .Language "sidebar.security.items.users" }}</span>
      </a>

    </nav>

    <div class="sidebar-foot">
      <details class="user-menu">
        <summary class="sidebar-user">
          <span class="avatar">U</span>
          <div class="sidebar-user-text">
            <div class="sidebar-user-name">{{ .User }}</div>
          </div>
          <svg class="user-menu-chev collapse-when-collapsed" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="user-menu-pop">
          <div class="user-menu-head">
            <div class="text-[13px] font-medium">{{ .User }}</div>
          </div>
          <div class="user-menu-divider"></div>
          <a href="#" class="user-menu-item" data-action="theme-toggle" role="menuitem">
            <svg class="theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg class="theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <span>{{ localize .Language "theme.label" }}: <span data-theme-label></span></span>
          </a>
          <div class="user-menu-divider"></div>
          <a href="/auth/logout" class="user-menu-item danger" role="menuitem">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>{{ localize .Language "sidebar.logout" }}</span>
          </a>
        </div>
      </details>
    </div>

    <div class="sidebar-resize" data-action="sidebar-resize" aria-hidden="true" title="{{ localize .Language "sidebar.resize" }}"></div>
  </aside>
{{ end }}
