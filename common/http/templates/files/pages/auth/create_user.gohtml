{{ define "title" }}{{ localize .Language "auth.create_user.title" }}{{ end }}

{{/*
  The non HTMX fallback for /auth/user/new. Same fields as the modal, because
  both go through auth/user-form; only the surrounding chrome differs.
*/}}
{{ define "content" }}
  {{ template "auth/user-form" (dict
      "Language"     .Language
      "CSRFToken"    .CSRFToken
      "Username"     ""
      "UserID"       0
      "AllowedRoles" .Data.AllowedRoles
      "IsEdit"       false
      "Error"        ""
      "FullPage"     true) }}
{{ end }}
